/* rofi's configuration and its layout rules.
 *
 * rofi reads ~/.config/rofi/config.rasi and nothing in the mango tree points at
 * it, so modules/home/dotfiles.nix declaring this path is the only thing that
 * connects the two (docs/adr/0014). Declared as a FILE, not a directory: rofi
 * writes a cache and rofi.png next to it.
 *
 * The COLOURS are not here. `colors.rasi` next to this file is generated from
 * modules/home/palette.nix, the same palette the terminals and the bar use, so
 * `@accent` here and `@accent` in waybar/colors.css cannot drift apart. Change
 * a colour there and rebuild; change the shape below by hand.
 */

configuration {
  /* Only the modes something actually reaches: `drun` on ⌘Space, `calc`
   * and `emoji` on their own keys, and `run` from the mode switcher beside
   * drun — nothing opened a switcher until drun went on a key.
   *
   * `calc` and `emoji` come from the two plugins in
   * modules/system/desktop.nix; naming a mode whose plugin is not built makes
   * `rofi -show calc` print "Mode calc is not found" to a stderr nobody is
   * reading and exit 1 — a key that does nothing. The list here and the plugin
   * list there are held together by checks/static.sh. */
  modes: "drun,run,calc,emoji";

  /* ⌥Space. rofi's default is `window,run`, which is neither half of
   * what that key is for — `run` lists every binary on PATH and would bury the
   * windows. Not added to `modes:` above: combi is reached by its own key, and
   * a tab for it inside drun would be a tab that re-contains drun. */
  combi-modes: "drun,window";

  recursivebrowser {
    /* ⌥⇧E walks $HOME. 190,640 entries with the default regex, in
     * 0.33s warm — the mode is threaded and fills the list behind an open
     * window, so this is a size rather than a wait.
     *
     * The regex is a SKIP list and it PRUNES: recursivebrowser.c:201 `continue`s
     * before the DT_DIR case that queues the descent, so a matched directory is
     * not entered. `^(\..*)` is rofi's default and carries the whole of the
     * dot-tree — .cache alone is 92,914 entries and .local/share/Steam 186,560,
     * which is why $HOME reads as a million and walks as 190k. Losing that
     * branch by writing a regex without it is the trap here.
     *
     * `Games` is a Wine prefix tree whose dosdevices/ are broken symlinks: 1,940
     * "Failed to stat" warnings on stderr nobody reads, for entries that cannot
     * open. `node_modules` is 12,301 entries nothing looks for by name. */
    filter-regex: "^(\\..*|node_modules|Games)$";
  }

  /* Menu entries carry nf-md glyphs in the string itself, so this must be a
   * Nerd Font or every icon renders as a box.
   *
   * Hack, not the bar's 3270: this is body text in a list, and 3270 is a narrow
   * bitmap-derived display face that needs bold to hold together at all. Two
   * faces by role, not one everywhere. docs/adr/0059.
   *
   * Declared in modules/system/fonts.nix, and checks/static.sh resolves the
   * name against the built font closure — a family that matches nothing falls
   * back silently. */
  font: "Hack Nerd Font 11";

  /* The glyphs are already in the text; icon lookup would add a per-entry
   * theme scan for nothing. drun IS on a key now (docs/adr/0043) and still
   * does without them: icons there would resolve the icon SET, which is a
   * `native = false` stand-in on this scheme and falls back silently
   * (docs/adr/0041). */
  show-icons: false;
  drun-display-format: "{name}";

  /* Typing matches whatever the entry's case is. This is rofi's default, and
   * it is written out anyway for the same reason `lines` is: on rofi 2.0 the
   * file beats the command line, so `-i` at a call site is not something to
   * rely on — and `kb-toggle-case-sensitivity` (the backtick) flips it inside a
   * running menu, which is a keystroke away from every hand-built menu here. */
  case-sensitive: false;

  /* ...unless the query carries an uppercase character, which makes that one
   * query case-sensitive. An all-lowercase query is unaffected. Verified
   * 2026-08-29: `-filter F` returns Firefox and not firefox-esr. */
  case-smart: true;

  /* run mode's Shift+Enter, and ssh mode if it is ever bound. The default is
   * `rofi-sensible-terminal`, a script that probes eighteen names in ITS order
   * — `... alacritty kitty wezterm foot ghostty` — and execs the first that
   * resolves. Three of them are installed here, so it landed on kitty. It reads
   * $TERMINAL first, which is unset in a keybind's environment.
   * checks/static.sh resolves this name against both profiles. */
  terminal: "foot";

  calc {
    /* Without this, Enter on a result does nothing: rofi-calc writes the
     * result to stdout, and a rofi spawned from a keybind has no stdout
     * anyone reads. The plugin runs this through `/bin/sh -c` — which does
     * exist on NixOS, unlike /bin/bash. */
    calc-command: "echo -n '{result}' | wl-copy";
  }
}

@import "colors"

/* The icon theme name, generated by modules/home/dotfiles.nix from the same
 * palette `colors` comes from. rofi does not read GTK's setting and falls back
 * to Adwaita without this. docs/adr/0060 */
@import "icons"

/* ==========================================================================
   Shape.

   The system's design language, and none of it is invented here — it is read
   off what already exists:

     config.conf   border_px=1, border_radius=0, border_color=0x3c3836,
                   focus_color=0xd79921, gaps 0
     style-solid.css   border-radius: 0, `border: none` with 1px @overlay
                   hairlines, flat transparent modules, and selection drawn as
                   `background: @accent; color: @base` on the active workspace

   So: square, 1px, flat, one accent, no zebra striping. rofi's own shipped
   gruvbox-dark disagreed with all four — 2px borders, an #a89984 border that
   matches nothing here, #665c54 selection where the terminals use #504945, and
   alternate rows striped #32302f. It is a different gruvbox, not this one.
   ========================================================================== */

/* Map rofi's ROLE names onto the palette, rather than styling widgets one by
 * one. This is not stylistic — a widget with no rule of its own still resolves
 * through these, and rofi's built-in defaults are **Solarized light**
 * (`background: #fdf6e3`, `foreground: #002b36`). Styling only the widgets you
 * can name leaves the rest cream-on-teal, and you find out the first time a
 * menu marks a row urgent. `rofi -dump-theme` is the check: nothing in the
 * output should still read `var(lightbg)`, `var(blue)` or `var(red)`.
 *
 * The `alternate-*` roles are deliberately identical to their `normal-*`
 * counterparts. That is what turns off zebra striping, which rofi's shipped
 * gruvbox does and nothing else on this system does. */
* {
  background:                  @base;
  background-color:            transparent;
  foreground:                  @text;
  border-color:                @overlay;
  separatorcolor:              @overlay;
  scrollbar-handle:            @overlay;
  text-color:                  @text;

  normal-background:           transparent;
  normal-foreground:           @text;
  alternate-normal-background: transparent;
  alternate-normal-foreground: @text;
  selected-normal-background:  @accent;
  selected-normal-foreground:  @base;

  active-background:           transparent;
  active-foreground:           @accent;
  alternate-active-background: transparent;
  alternate-active-foreground: @accent;
  selected-active-background:  @accent;
  selected-active-foreground:  @base;

  urgent-background:           transparent;
  urgent-foreground:           @urgent;
  alternate-urgent-background: transparent;
  alternate-urgent-foreground: @urgent;
  selected-urgent-background:  @urgent;
  selected-urgent-foreground:  @base;

  /* Matched substring. Bold only: italic in a mono Nerd Font reflows the
   * glyph advance, so the icon column visibly shifts as you type. */
  highlight:                   bold;
}

/* THE MENU HAS TO DRAW ITS OWN EDGE. rofi 2.0 is a LAYER SURFACE — mango does
 * not list it in `mmsg get all-clients` and draws no border on it, and with
 * `shadows=0` and `layer_shadows=0` there is nothing else separating the menu
 * from a window the same colour behind it.
 *
 * @accent, and it IS mango's `focus_color` — the launcher wears the ring the
 * focused window wears. It replaced achromatic @subtext on 2026-08-21, when
 * ⌘Space became `rofi -show drun`; docs/adr/0043 has the argument.
 * Measured against @base across every scheme in service, not just the selected
 * one: heartbox 3.87:1, gruvbox 5.94:1, nord 5.99:1, mocha 8.07:1,
 * mocha-high-contrast 9.23:1. `bg3` and `comment` are still unusable — both
 * collapse in nord (1.69:1). */
window {
  background-color: @base;
  border:           1px;
  border-color:     @accent;
  border-radius:    0;
  padding:          0;
  width:            40em;
}

/* No `children` list. Setting one is how the live calc preview was lost on
 * 2026-08-14: rofi's default is [ inputbar, message, listview, mode-switcher ],
 * this said [ inputbar, listview ], and rofi-calc renders its running result
 * through the mode `_get_message` hook — which `rofi_view_reload_message_bar`
 * (view.c:208) drops on the floor when `mesg_box` is NULL, i.e. whenever
 * `message` is not in the layout. Nothing logged; Enter still worked, because
 * `calc-command` runs off the entry rather than the message. Pinning this list
 * opts out of every widget rofi adds, present and future, to reorder nothing —
 * the default order is already the wanted one. */
mainbox {
  border:  0;
  padding: 0;
}

/* One hairline under the input, in the bar's separator colour — the same rule
 * `window#waybar` uses to divide itself from the windows below it. */
inputbar {
  padding:      6px 10px;
  spacing:      8px;
  border:       0 0 1px 0;
  border-color: @overlay;
  children:     [ prompt, entry ];
}

prompt {
  text-color: @accent;
}

entry {
  text-color:        @text;
  placeholder-color: @subtext;
  /* rofi's default is the literal "Type to filter". Every caller already
   * passes `-p`, so that would be a second label saying less. */
  placeholder:       "";
}

listview {
  /* `lines` IS A FIXED HEIGHT, and the comment that used to sit here said the
   * opposite. `dynamic` does not fit the list to its contents — rofi's own
   * docs: "True if the size should change when FILTERING the list" — so every
   * menu rendered twelve rows tall whatever it held: a two-entry mode picker
   * with ten blank rows, and the control centre paging the moment it grew a
   * thirteenth row. Measured on 2026-08-20 at 2, 6, 15 and 30 entries: the
   * window never changed size.
   *
   * `-l` cannot fix it either. On rofi 2.0 the theme overrides the command
   * line, so the `-l` a caller passes is accepted and ignored. `-theme-str`
   * is the override that works, and lib.sh's `rofi_menu` is where it lives —
   * every hand-built menu sizes itself to its input through that.
   *
   * This value is therefore the CAP for the callers that do NOT go through
   * rofi_menu: `rofi -show drun|run|window|calc|emoji`, which are unbounded
   * lists where paging is the honest answer. docs/gotchas.md -> rofi. */
  lines:     12;
  dynamic:   true;
  scrollbar: false;
  border:    0;
  padding:   4px 0;
  spacing:   0;
}

/* Flat, like the bar's modules: no per-row background, generous horizontal
 * padding, tight vertical. The separator rows the menus draw ("──────") are
 * ordinary entries, so anything with a background here would box them too. */
element {
  padding: 4px 10px;
  border:  0;
}

/* No per-state `element` rules: the roles above already carry all nine
 * combinations, and repeating them here is how the two drift. Selection comes
 * out as the accent block, exactly as `#workspaces button.active` draws the
 * focused workspace on the bar. */

element-text,
element-icon {
  background-color: inherit;
  text-color:       inherit;
  vertical-align:   0.5;
}

/* THE MODE SWITCHER DRAWS FOR `-show drun` AND FOR NOTHING ELSE — the nine
 * hand-built menus are `-dmenu`, which is single-mode. It had no rule at all
 * until ⌘Space became a rofi mode (docs/adr/0043), so it would have
 * rendered on rofi's own metrics the first time the launcher opened. Flat, and
 * the selected tab is underlined rather than blocked: `selected-normal-background`
 * is already the accent block, and two of those in one window compete. */
mode-switcher {
  border:       1px 0 0 0;
  border-color: @overlay;
}

button {
  padding:    4px 10px;
  text-color: @subtext;
}

button selected {
  text-color:   @text;
  border:       0 0 2px 0;
  border-color: @accent;
}

/* The weather panel's header block — `scripts/system/weather.sh panel`, the
 * only `-mesg` caller here (docs/adr/0050). An unstyled widget inherits rofi's
 * built-in theme rather than nothing, which is why this had a rule while
 * nothing passed one.
 *
 * 12px at the BOTTOM, not the 6px the other three sides carry. rofi sizes the
 * window from the CONFIGURED font's metrics, not from the rendered layout, so a
 * markup span larger than `font:` overflows the space it was given and the last
 * line is clipped — by about one line for the panel's `size="xx-large"`
 * headline. Measured both ways on 2026-08-26; docs/gotchas.md -> rofi. */
message {
  padding:      6px 10px 12px 10px;
  border:       0 0 1px 0;
  border-color: @overlay;
}

/* @text, not the @subtext every other textbox wears: this widget is the
 * panel's headline and its reading, not a hint about one. Hierarchy inside it
 * is size and weight — colour stays reserved for state, as on the bar
 * (docs/adr/0048), and a hex code in a script would be a sixth copy of the
 * palette anyway. */
message textbox {
  text-color: @text;
}

textbox {
  text-color: @subtext;
}

/* The match counter. Not in `inputbar`'s children, so it does not draw today —
 * but rofi hardcodes these three to a literal `Gray` rather than resolving a
 * role, so they are the one place the sweep above cannot reach. Named here so
 * adding them to the inputbar later is a one-line change, not a surprise. */
num-filtered-rows,
num-rows,
textbox-num-sep {
  text-color: @subtext;
}

/* `no-custom` is NOT set here, deliberately. It belongs at the call site:
 * every fixed-choice menu passes `-no-custom` so a typo cannot return itself
 * and fall silently through the handler's `*)` branch, while the password
 * prompt in menus/network-menu.sh must NOT pass it — there the typed string
 * is the answer. Setting it globally would need un-setting for that one call,
 * and rofi has no negation for it: `-no-no-custom` is accepted, ignored, and
 * exits 0.
 */
